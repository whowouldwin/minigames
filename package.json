{
  "name": "minigames",
  "version": "1.0.0",
  "description": "MiniGames is a single-page web application developed as part of the RS School Qualifying Stage.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/create-spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whowouldwin/minigames.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/whowouldwin/minigames/issues"
  },
  "homepage": "https://github.com/whowouldwin/minigames#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^75.0.0",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
